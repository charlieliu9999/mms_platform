# MMS Platform Backend Dockerfile - 优化版（使用国内镜像源）
FROM python:3.11-slim

# 使用阿里云 Debian 镜像源加速
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources

# 设置工作目录
WORKDIR /app

# 安装系统依赖（包含 postgresql-client 用于数据库就绪检查）
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# 使用清华大学 pip 镜像源
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 安装 Poetry
RUN pip install poetry==1.7.1

# 复制依赖配置
COPY pyproject.toml poetry.lock ./

# 配置 Poetry 不创建虚拟环境（容器内不需要）
RUN poetry config virtualenvs.create false

# 安装依赖
RUN poetry install --without dev --no-root

# 复制应用代码
COPY src/ ./src/
COPY migrations/ ./migrations/
COPY alembic.ini ./

# 创建日志目录
RUN mkdir -p /app/logs

# 暴露端口
EXPOSE 8000

# 启动命令（等待数据库就绪，运行迁移，启动服务）
CMD ["sh", "-c", "until pg_isready -h ${DATABASE_HOST:-acrac_web_mgmt_postgres_prod} -p ${DATABASE_PORT:-5432} -U ${DATABASE_USER:-postgres}; do echo 'Waiting for database...'; sleep 2; done && echo 'Database ready!' && poetry run alembic upgrade head && poetry run uvicorn match_service.main:app --host 0.0.0.0 --port 8000"]
