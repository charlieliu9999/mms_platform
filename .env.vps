# MMS Platform Environment Variables for VPS Deployment
# 复制此文件到 VPS:/data/mms-platform/.env 并填写实际值

# 数据库配置（连接到 acrac_web_mgmt 的 PostgreSQL 容器）
MATCH_SVC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@acrac_web_mgmt_postgres_prod:5432/acrac_db

# Redis 配置（连接到 acrac_web_mgmt 的 Redis 容器）
MATCH_SVC_REDIS_URL=redis://acrac_web_mgmt_redis_prod:6379/0

# 引擎模式
MATCH_SVC_ENGINE_MODE=local

# 日志级别
MATCH_SVC_LOG_LEVEL=INFO

# CORS 配置
MATCH_SVC_CORS_ORIGINS=["http://localhost:3100","http://220.154.3.166:3100"]

# AI Agent 配置（可选）
# MATCH_SVC_LLM_API_BASE=https://api.openai.com/v1
# MATCH_SVC_LLM_API_KEY=your-api-key
# MATCH_SVC_LLM_MODEL=gpt-4
