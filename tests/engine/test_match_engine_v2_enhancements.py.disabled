"""
匹配引擎 V2 增强测试 - 测试新增的三个优化
"""
import asyncio
import pytest

from match_service.db import get_engine
async_engine = get_engine()
from match_service.engine.match_engine_v2.orchestrator import (
    MatchEngineOrchestrator
)


@pytest.fixture(scope="module")
def event_loop():
    loop = asyncio.new_event_loop()
    loop.run_until_complete(async_engine.dispose())
    yield loop
    loop.run_until_complete(async_engine.dispose())
    loop.close()


@pytest.fixture(scope="module")
def engine(event_loop):
    """匹配引擎实例"""
    orch = MatchEngineOrchestrator(async_engine)
    event_loop.run_until_complete(orch.initialize())
    return orch


# ─── 测试1: 特殊 CT 独立模态归未匹配（P0-1 改：不再走 unmatchable 标记）──────

def test_unmatchable_cbct(engine):
    """CBCT 提升为独立模态：infer 推断为 CBCT，引擎不识别该模态→未匹配。"""
# Phase A: modality_inference 已移除（不在 match_service 范围内）
        infer_engine_modality,
    )
    assert infer_engine_modality('CBCT头部', 'CT') == 'CBCT'
    result = engine.match('CBCT头部', 'CBCT', 'V3.9')
    assert result['num_standard'] == 0


def test_unmatchable_4dct(engine):
    """4DCT 提升为独立模态 CT-4D：引擎不识别该模态→未匹配。"""
# Phase A: modality_inference 已移除（不在 match_service 范围内）
        infer_engine_modality,
    )
    assert infer_engine_modality('4DCT胸部', 'CT') == 'CT-4D'
    result = engine.match('4DCT胸部', 'CT-4D', 'V3.9')
    assert result['num_standard'] == 0


def test_unmatchable_dual_energy(engine):
    """双能CT 提升为独立模态 CT-DE：引擎不识别该模态→未匹配。"""
# Phase A: modality_inference 已移除（不在 match_service 范围内）
        infer_engine_modality,
    )
    assert infer_engine_modality('CT双能扫描尿酸盐识别', 'CT') == 'CT-DE'
    result = engine.match('CT双能扫描尿酸盐识别', 'CT-DE', 'V3.9')
