# ─── 匹配服务配置 ───────────────────────────────────────────────────────────
# 所有变量前缀: MATCH_SVC_

# MMS 独立数据库。运行账号仅授权 mms_db，不使用主项目账号。
MATCH_SVC_DATABASE_URL=postgresql+asyncpg://mms_service:CHANGE_ME@127.0.0.1:15432/mms_db
MATCH_SVC_ENGINE_MODE=local

# Redis（可选，用于热缓存加速 L1 查询）
MATCH_SVC_REDIS_URL=redis://127.0.0.1:16379/1

# L1 映射库配置
MATCH_SVC_MATCH_CACHE_TTL=2592000
MATCH_SVC_MATCH_CACHE_MIN_CONFIDENCE=0.8
# 匹配测试中心批量运行前默认清空 L1，避免旧规则结果延续
MATCH_SVC_PROCEDURE_MATCH_CLEAR_CACHE_BEFORE_RUN=true

# L3 Agent LLM 配置（P2 阶段启用）
MATCH_SVC_LLM_API_BASE=
MATCH_SVC_LLM_API_KEY=
MATCH_SVC_LLM_MODEL=

# 服务配置
MATCH_SVC_HOST=0.0.0.0
MATCH_SVC_PORT=9100
MATCH_SVC_DEBUG=false
